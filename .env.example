# Django Settings
SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database
DB_ENGINE=django.db.backends.postgresql
DB_NAME=facman_db
DB_USER=postgres
DB_PASSWORD=your-db-password
DB_HOST=localhost
DB_PORT=5432

# Facebook App Configuration
FACEBOOK_APP_ID=your-facebook-app-id
FACEBOOK_APP_SECRET=your-facebook-app-secret
FACEBOOK_REDIRECT_URI=http://localhost:8000/auth/facebook/callback
FACEBOOK_API_VERSION=v18.0

# OAuth Settings
FACEBOOK_OAUTH_URL=https://www.facebook.com/v18.0/dialog/oauth
FACEBOOK_GRAPH_URL=https://graph.facebook.com/v18.0
FACEBOOK_SCOPES=pages_show_list,pages_read_engagement,pages_manage_posts,pages_manage_metadata,pages_manage_engagement,pages_messaging,pages_read_user_content,public_profile,email

# Redis Configuration (for Celery and caching)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# Celery Configuration
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
CELERY_TIMEZONE=UTC

# Security
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000
CSRF_TRUSTED_ORIGINS=http://localhost:3000

# Email Configuration (for notifications)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-email-password

# Frontend URL
FRONTEND_URL=http://localhost:3000

# Media Files
MEDIA_URL=/media/
MEDIA_ROOT=media/

# Static Files
STATIC_URL=/static/
STATIC_ROOT=static/

# Logging
LOG_LEVEL=DEBUG
LOG_FILE=logs/facman.log

# Encryption Key (for storing tokens)
ENCRYPTION_KEY=generate-a-32-byte-key-here

# Webhook Configuration
WEBHOOK_VERIFY_TOKEN=your-webhook-verify-token
WEBHOOK_CALLBACK_URL=https://your-domain.com/webhooks/facebook

# Development Settings
USE_NGROK=True  # For local HTTPS tunnel during development
NGROK_AUTHTOKEN=your-ngrok-authtoken